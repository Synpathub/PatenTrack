# Application
NODE_ENV=development
PORT=4200

# API Server
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Database
DATABASE_URL=postgresql://patentrack:patentrack_dev@localhost:5432/patentrack

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production

# Sentry (optional)
SENTRY_DSN=

# EPO API (optional, needed for P1)
EPO_KEY=
EPO_SECRET=

# USPTO Bulk Data
USPTO_BULK_DATA_URL=https://bulkdata.uspto.gov

# GitHub (for monitoring agent)
GITHUB_TOKEN=
GITHUB_REPO=Synpathub/PatenTrack
GITHUB_OWNER=Synpathub

# File Storage
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
STATIC_FILES_PATH=/var/www/patentrack/static
