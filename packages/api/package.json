{
  "name": "@patentrack/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@patentrack/core": "workspace:*",
    "@patentrack/shared": "workspace:*",
    "@patentrack/db": "workspace:*",
    "@fastify/cors": "8.5.0",
    "@fastify/jwt": "7.2.4",
    "@fastify/rate-limit": "9.1.0",
    "@fastify/websocket": "9.0.0",
    "fastify": "5.7.2",
    "fastify-plugin": "4.5.1",
    "bcrypt": "5.1.1",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/node": "20.11.24",
    "@types/ws": "8.5.10",
    "tsx": "4.7.1",
    "typescript": "5.3.3",
    "vitest": "1.6.1"
  }
}
