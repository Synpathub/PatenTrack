{
  "name": "@patentrack/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "migrate": "tsx src/migrations/run-migrations.ts",
    "seed": "tsx src/seed/seed.ts"
  },
  "dependencies": {
    "@patentrack/core": "workspace:*",
    "@patentrack/shared": "workspace:*",
    "drizzle-orm": "0.30.1",
    "postgres": "3.4.3",
    "bcrypt": "5.1.1"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/node": "20.11.24",
    "drizzle-kit": "0.20.14",
    "tsx": "4.7.1",
    "typescript": "5.3.3",
    "vitest": "1.6.1"
  }
}
